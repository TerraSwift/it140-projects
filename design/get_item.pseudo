# - inventory: Lst trasking keys collected by player (starts empty)

    # TODO 2: Prompt for and receive the player's get-item command.
OUTPUT "You are in the " + current_room
OUTPUT "Keys collecte: " + inventory
IF curent_room has a key AND key is NOT in inventory THEN
    OUTPUT " You see the " + room_item + "here."
ELSE
    OUTPUT "There are no keys left to find in this room." 
END IF
INPUT player_command

    # TODO 3: Validate whether the requested item is available in the current
    IF player_comand starts with "get" THEN
        EXTRACT requested_item from player_command
IF current_room has a key AND requested_item equals roo_item THEN

    # TODO 4: Describe what happens when the item request is valid.
    IF requested_item is NOT in inventory THN
        ADD requested_item to inventory 
        REMOVE key from current_room
        OUTPUT requested_item + "has been added to your key collection!"
ELSE
    OUTPUT "You already have the " + requested_item + "."
END IF

    # TODO 5: Describe what happens when the item request is invalid.
    # Include the output the player should receive. 
ELSE
    OUTPUT "Invalid command. Enter 'get [key name]' or a move command."
END IF

    # TODO 6: Show how the process returns to or continues the larger gameplay
